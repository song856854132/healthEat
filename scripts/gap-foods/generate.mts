// Generates packages/shared/src/gapFoods.data.ts (T26; eng review D3): about 60 whole foods with their
// energy and tracked nutrients per 100 g, read once from USDA FoodData Central (public domain, CC0)
// through the project's own API proxy, so no USDA key is needed on the machine that runs it. Run by
// hand when the list changes, never at request time:
//   API_ORIGIN=https://healtheat-api-staging.vercel.app npx tsx scripts/gap-foods/generate.mts
import { writeFileSync } from "node:fs";
import { ENERGY, TRACKED_NUTRIENTS } from "../../packages/shared/src/summary.ts";

const QUERIES = [
  "sunflower seeds dried",
  "Nuts, almonds",
  "peanuts raw",
  "Nuts, walnuts, english",
  "pumpkin seeds",
  "chia seeds",
  "flaxseed",
  "sesame seeds",
  "cashews raw",
  "spinach raw",
  "kale raw",
  "broccoli raw",
  "carrots raw",
  "Sweet potato, cooked, baked in skin, flesh, without salt",
  "red bell pepper raw",
  "Tomatoes, red, ripe, raw, year round average",
  "avocado raw",
  "banana raw",
  "Oranges, raw, all commercial varieties",
  "kiwifruit",
  "strawberries raw",
  "blueberries raw",
  "mango raw",
  "Apples, raw, with skin",
  "lentils boiled",
  "chickpeas boiled",
  "black beans boiled",
  "kidney beans boiled",
  "edamame",
  "Tofu, firm, prepared with calcium sulfate",
  "Cereals, oats, regular and quick, not fortified, dry",
  "quinoa cooked",
  "Rice, brown, long-grain, cooked",
  "Bread, whole-wheat, commercially prepared",
  "salmon atlantic cooked",
  "sardines canned in oil",
  "tuna light canned in water",
  "Chicken, broilers or fryers, breast, meat only, cooked, roasted",
  "beef ground cooked",
  "pork loin cooked",
  "egg whole boiled",
  "Milk, whole, 3.25% milkfat, with added vitamin D",
  "yogurt plain whole milk",
  "Cheese, swiss",
  "shrimp cooked",
  "mushrooms white raw",
  "potato baked with skin",
  "green peas cooked",
  "asparagus cooked",
  "brussels sprouts cooked",
  "cauliflower raw",
  "beets cooked",
  "papaya raw",
  "cantaloupe raw",
  "dates medjool",
  "raisins",
  "prunes dried",
  "liver beef cooked",
  "Mollusks, oyster, eastern, wild, cooked, dry heat",
  "mussels cooked",
];

const origin = process.env.API_ORIGIN ?? "https://healtheat-api-staging.vercel.app";
const ids = new Set(
  [ENERGY, ...TRACKED_NUTRIENTS].flatMap((t) => [t.id, ...t.alternates.map((a) => a.id)]),
);

type Hit = { fdcId: number; description: string; dataType: string };
type Details = Hit & { nutrients: { nutrientId: number; amountPer100g: number }[] };
const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
// USDA answers 503 now and then; retry a few times with a pause, then give up on that food.
const get = async (path: string) => {
  for (let attempt = 1; ; attempt++) {
    await sleep(400);
    const res = await fetch(`${origin}${path}`);
    if (res.ok) return res.json();
    if (attempt === 4) throw new Error(`${res.status} for ${path}`);
    await sleep(2000 * attempt);
  }
};

const out: { fdcId: number }[] = [];
for (const q of QUERIES) {
  let hit: Hit | undefined;
  for (const dataType of ["SR Legacy", "Foundation"]) {
    const page = (await get(
      `/api/foods/search?q=${encodeURIComponent(q)}&dataType=${encodeURIComponent(dataType)}`,
    )) as { foods: Hit[] };
    hit = page.foods[0];
    if (hit) break;
  }
  if (!hit) throw new Error(`no USDA match for "${q}"`);
  let food: Details;
  try {
    food = (await get(`/api/foods/${hit.fdcId}`)) as Details;
  } catch (err) {
    console.error(`skipped "${q}": ${(err as Error).message}`);
    continue;
  }
  const nutrients = food.nutrients
    .filter((x) => ids.has(x.nutrientId))
    .map((x) => ({ nutrientId: x.nutrientId, amountPer100g: x.amountPer100g }));
  out.push({
    fdcId: food.fdcId,
    description: food.description,
    dataType: food.dataType,
    nutrients,
  });
}
const retrieved = new Date().toISOString().slice(0, 10);
writeFileSync(
  new URL("../../packages/shared/src/gapFoods.data.ts", import.meta.url),
  `// Generated by scripts/gap-foods/generate.mts on ${retrieved} from USDA FoodData Central (public
// domain); see packages/shared/data/PROVENANCE.md. Do not edit by hand: rerun the script.
export const GAP_FOODS_RETRIEVED = "${retrieved}";
export const GAP_FOODS: {
  fdcId: number;
  description: string;
  dataType: string;
  nutrients: { nutrientId: number; amountPer100g: number }[];
}[] = ${JSON.stringify(out, null, 2)};
`,
);
console.log(`wrote ${out.length} foods`);
